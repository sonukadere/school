{
  "name": "school-management-backend",
  "version": "1.0.0",
  "description": "Production-ready School Management System Backend built with Node.js, Express, PostgreSQL and Prisma ORM.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "dev": "node src/config/ensureMongo.js && nodemon src/server.js",
    "db:start": "node src/config/ensureMongo.js",
    "mongo:start": "powershell -ExecutionPolicy Bypass -File ./start-mongo.ps1",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:push": "prisma db push"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "school-management",
    "express",
    "prisma",
    "postgresql",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "prisma": "^5.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
