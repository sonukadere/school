# ==========================================
# School Management System - Backend Environment
# ==========================================

# Server Port and Environment
PORT=5000
NODE_ENV=production

# Client Application URL (For CORS allowed origins)
# Example: https://your-school-frontend.onrender.com or http://localhost:5173
CLIENT_URL=https://your-school-frontend.onrender.com

# Database Connection (MongoDB Atlas)
# Prisma supports DATABASE_URL; MONGODB_URI is also synchronized automatically.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ywjskqg.mongodb.net/school_management?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.ywjskqg.mongodb.net/school_management?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-characters
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Default Administrator Credentials (created during seed)
ADMIN_EMAIL=admin@school.com
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_NAME=System Administrator

# Optional: Razorpay Payment Gateway (Backend Only - NEVER expose secret to frontend)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Optional: Firebase Cloud Messaging (Push Notifications)
# Configure via Render Secret Files: /etc/secrets/firebase-service-account.json
# Or via FIREBASE_SERVICE_ACCOUNT base64 string
FIREBASE_SERVICE_ACCOUNT=
