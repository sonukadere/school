generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mongodb"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// -------------------------------------------------------------
// Enums
// -------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  PARENT
  STAFF
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TRANSFERRED
  GRADUATED
  ALUMNI
}

enum PaymentStatus {
  PAID
  PARTIAL
  PENDING
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  CHEQUE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum Audience {
  ALL
  STUDENT
  TEACHER
  PARENT
  ADMIN
  SUPER_ADMIN
}

enum HolidayType {
  PUBLIC
  SCHOOL
  EXAM
  RELIGIOUS
  OTHER
}

// -------------------------------------------------------------
// User
// -------------------------------------------------------------

model User {
  id        String   @id @default(cuid()) @map("_id")
  username  String   @unique
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  avatar    String?
  isActive  Boolean  @default(true)
  teacher   Teacher?
  student   Student?
  parent    Parent?
  staff     Staff?
  deviceTokens  DeviceToken[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([role])
}

// -------------------------------------------------------------
// Student
// -------------------------------------------------------------

model Student {
  id          String        @id @default(cuid()) @map("_id")
  studentId   String        @unique
  firstName   String
  lastName    String
  gender      Gender        @default(OTHER)
  dob         DateTime?
  fatherName  String?
  motherName  String?
  email       String?
  phone       String?
  address     String?
  section     String?
  rollNumber  Int?
  admissionDate DateTime?
  status      StudentStatus @default(ACTIVE)

  classId     String?
  class       Class?        @relation(fields: [classId], references: [id])

  parentId    String?
  parent      Parent?       @relation(fields: [parentId], references: [id], onDelete: SetNull)

  userId      String?       @unique
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  attendances Attendance[]
  fees        Fee[]
  marks       Mark[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  @@index([classId])
  @@index([status])
  @@unique([classId, rollNumber])
}

// -------------------------------------------------------------
// Teacher
// -------------------------------------------------------------

model Teacher {
  id           String   @id @default(cuid()) @map("_id")
  teacherId    String   @unique
  name         String
  email        String?  @unique
  phone        String?
  qualification String?
  salary       Float?
  joiningDate  DateTime?
  address      String?

  userId       String?  @unique
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Primary subject of the teacher
  subjectId    String?
  subject      Subject? @relation("TeacherPrimarySubject", fields: [subjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Subjects this teacher is assigned to teach
  assignedSubjects Subject[] @relation("SubjectAssignedTeacher")

  classes        Class[]            // as class teacher
  attendances    TeacherAttendance[]
  timetableSlots Timetable[]
  markedAttendances Attendance[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([subjectId])
}

// -------------------------------------------------------------
// Parent
// -------------------------------------------------------------

model Parent {
  id         String   @id @default(cuid()) @map("_id")
  parentId   String   @unique
  firstName  String
  lastName   String
  email      String?  @unique
  phone      String?
  occupation String?
  address    String?
  relation   String?

  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  children   Student[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?
}

// -------------------------------------------------------------
// Staff
// -------------------------------------------------------------

model Staff {
  id          String   @id @default(cuid()) @map("_id")
  staffId     String   @unique
  name        String
  email       String?  @unique
  phone       String?
  position    String
  department  String?
  salary      Float?
  joiningDate DateTime?
  address     String?

  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

// -------------------------------------------------------------
// Class
// -------------------------------------------------------------

model Class {
  id            String   @id @default(cuid()) @map("_id")
  name          String
  section       String
  roomNumber    String?

  classTeacherId String?
  classTeacher  Teacher? @relation(fields: [classTeacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  students      Student[]
  subjects      Subject[]
  exams         Exam[]
  timetables    Timetable[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@unique([name, section])
  @@index([classTeacherId])
}

// -------------------------------------------------------------
// Subject
// -------------------------------------------------------------

model Subject {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  code      String   @unique

  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  teacherId String?
  teacher   Teacher? @relation("SubjectAssignedTeacher", fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  primaryTeachers Teacher[] @relation("TeacherPrimarySubject")

  marks     Mark[]
  timetableSlots Timetable[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([classId, name])
  @@index([teacherId])
}

// -------------------------------------------------------------
// Attendance (Student)
// -------------------------------------------------------------

model Attendance {
  id        String           @id @default(cuid()) @map("_id")
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  remark    String?

  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  markedById String?
  markedBy  Teacher?         @relation(fields: [markedById], references: [id], onDelete: SetNull)

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  @@unique([studentId, date])
  @@index([date])
  @@index([markedById])
}

// -------------------------------------------------------------
// TeacherAttendance
// -------------------------------------------------------------

model TeacherAttendance {
  id        String           @id @default(cuid()) @map("_id")
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  remark    String?

  teacherId String
  teacher   Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  @@unique([teacherId, date])
  @@index([date])
}

// -------------------------------------------------------------
// Fee
// -------------------------------------------------------------

model Fee {
  id            String        @id @default(cuid()) @map("_id")
  totalFee      Float
  paidAmount    Float         @default(0)
  dueAmount     Float         @default(0)
  paymentDate   DateTime?
  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(PENDING)

  studentId     String
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  @@index([studentId])
  @@index([paymentStatus])
}

// -------------------------------------------------------------
// Exam
// -------------------------------------------------------------

model Exam {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  marks     Mark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([name, classId])
  @@index([classId])
}

// -------------------------------------------------------------
// Mark
// -------------------------------------------------------------

model Mark {
  id        String  @id @default(cuid()) @map("_id")
  marks     Float
  grade     String?
  remarks   String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  examId    String
  exam      Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([studentId, subjectId, examId])
  @@index([examId])
  @@index([subjectId])
}

// -------------------------------------------------------------
// Timetable
// -------------------------------------------------------------

model Timetable {
  id        String    @id @default(cuid()) @map("_id")
  day       DayOfWeek
  startTime String
  endTime   String

  classId   String
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  teacherId String?
  teacher   Teacher?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([classId, day])
  @@index([teacherId])
}

// -------------------------------------------------------------
// Notice
// -------------------------------------------------------------

model Notice {
  id          String   @id @default(cuid()) @map("_id")
  title       String
  description String?
  audience    Audience @default(ALL)
  publishDate DateTime @db.Date @default(now())
  expiryDate  DateTime? @db.Date

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([publishDate])
  @@index([audience])
}

// -------------------------------------------------------------
// Event
// -------------------------------------------------------------

model Event {
  id          String   @id @default(cuid()) @map("_id")
  title       String
  description String?
  date        DateTime @db.Date
  startTime   String?
  endTime     String?
  location    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([date])
}

// -------------------------------------------------------------
// Holiday
// -------------------------------------------------------------

model Holiday {
  id          String      @id @default(cuid()) @map("_id")
  name        String
  date        DateTime    @db.Date
  type        HolidayType @default(PUBLIC)
  description String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@unique([name, date])
  @@index([date])
}

// -------------------------------------------------------------
// Setting
// -------------------------------------------------------------

model Setting {
  id           String  @id @default(cuid()) @map("_id")
  schoolName   String
  schoolLogo   String?
  address      String?
  phone        String?
  email        String?
  website      String?
  academicYear String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
}

// -------------------------------------------------------------
// Firebase Push Notifications & Device Tokens
// -------------------------------------------------------------

model DeviceToken {
  id         String   @id @default(cuid()) @map("_id")
  token      String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceType String?  @default("web")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid()) @map("_id")
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String?   @default("GENERAL")
  data      String?
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([isRead])
}

